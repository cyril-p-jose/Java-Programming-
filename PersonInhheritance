package OOPSC26CS070;

class Person
{
    String name;
    int age;
    String email;
    String address;
    double salary;

    void displayPersonInfo()
    {
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("Email: " + email);
        System.out.println("Address: " + address);
        System.out.println("Salary: " + salary);
    }
}

class Student extends Person
{
    String major;

    void displayMajor()
    {
        System.out.println("Major: " + major);
    }
}

class Instructor extends Person
{
    String subject;

    void displaySubject()
    {
        System.out.println("Subject: " + subject);
    }
}

public class PersonInhheritance
{
    public static void main(String[] args)
    {
        // Creating Student object
        Student s = new Student();

        s.name = "cyril";
        s.age = 19;
        s.email = "cyril@gmail.com";
        s.address = "Kochi";
        s.salary = 0;
        s.major = "Computer Science";

        // Creating Instructor object
        Instructor i = new Instructor();

        i.name = "David";
        i.age = 40;
        i.email = "david@gmail.com";
        i.address = "Kochi";
        i.salary = 50000;
        i.subject = "Java";

        // Display Student details
        System.out.println("----- STUDENT -----");
        s.displayPersonInfo();
        s.displayMajor();

        // Display Instructor details
        System.out.println("\n----- INSTRUCTOR -----");
        i.displayPersonInfo();
        i.displaySubject();
    }
}
