package OOPSC26CS070;
class OuterClass
{
    int number = 10; 
    void test()
    { System.out.println("Number = "+number);
    MyNestedClass obj=new MyNestedClass();
    obj.display();
    }
   class MyNestedClass
    {
    	int mynumber=50;
        void display()
        {
        	//OuterClass ob=new OuterClass();
        	//ob.test();
        
            System.out.println("Number = " +number);
            System.out.println("MyNumber = " + mynumber);
        }
    }
}
public class StaticNestedDemo
{
    public static void main(String[] args)
    {
    	 OuterClass ob1=new OuterClass();
         ob1.test();
         
        // Create object of static nested class
       OuterClass.MyNestedClass ob=ob1.new MyNestedClass();
        ob.display();
       
    }
}
